{
  "name": "cartes",
  "version": "0.4.0",
  "description": "Des outils libres pour aider les communes de France à créer des cartes détaillées de leur territoire, prêtes à imprimer en grand format",
  "keywords": [
    "cartographie",
    "carte",
    "commune",
    "collectivité",
    "ign",
    "geoplateforme",
    "tuiles",
    "impression"
  ],
  "homepage": "https://github.com/sebprunier/cartes#readme",
  "bugs": {
    "url": "https://github.com/sebprunier/cartes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebprunier/cartes.git"
  },
  "license": "MIT",
  "author": "Sébastien Prunier",
  "type": "module",
  "bin": {
    "cartes": "./src/node/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js --serve",
    "build:electron": "node scripts/build-electron.js",
    "electron": "node scripts/build-electron.js && electron .",
    "package:electron": "node scripts/build-electron.js && electron-builder"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.13"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "fr.cartes.app",
    "productName": "cartes",
    "directories": {
      "output": "dist-installers"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "docs/images/logo.png",
    "files": [
      "electron/**",
      "dist-electron/**",
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science",
      "synopsis": "Cartes détaillées des communes de France",
      "description": "Génère la carte détaillée d'une commune française à partir des fonds de carte ouverts de l'IGN, avec son contour, les couches de risques et les données de la commune, prête à imprimer en grand format.",
      "desktop": {
        "entry": {
          "Keywords": "carte;commune;IGN;cadastre;impression;",
          "Comment": "Cartes détaillées des communes de France"
        }
      }
    }
  }
}

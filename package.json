{
  "name": "cartes",
  "version": "0.1.0",
  "description": "Des outils libres pour aider les communes de France à créer des cartes détaillées de leur territoire, prêtes à imprimer en grand format",
  "keywords": [
    "cartographie",
    "carte",
    "commune",
    "collectivité",
    "ign",
    "geoplateforme",
    "tuiles",
    "impression"
  ],
  "homepage": "https://github.com/sebprunier/cartes#readme",
  "bugs": {
    "url": "https://github.com/sebprunier/cartes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebprunier/cartes.git"
  },
  "license": "MIT",
  "author": "Sébastien Prunier",
  "type": "module",
  "bin": {
    "cartes": "./src/node/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "build:web": "node scripts/build-web.js",
    "web": "node scripts/build-web.js --serve",
    "build:electron": "node scripts/build-electron.js",
    "electron": "node scripts/build-electron.js && electron .",
    "package:electron": "node scripts/build-electron.js && electron-builder"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "fr.cartes.app",
    "productName": "cartes",
    "files": [
      "electron/**",
      "dist-electron/**",
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Science"
    }
  }
}
